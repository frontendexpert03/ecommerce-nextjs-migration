{
	"name": "kiiibs-next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "next typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:headed": "cross-env SLOW_MO=300 playwright test --headed --workers=1",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:docker": "node scripts/playwright-docker.mjs",
		"test:visual": "node scripts/playwright-docker.mjs --project=visual-desktop --project=visual-mobile",
		"e2e:codegen": "playwright codegen --test-id-attribute=data-test http://localhost:3100",
		"lighthouse": "node scripts/lighthouse.mjs"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"dependencies": {
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"autoprefixer": "10.4.15",
		"chrome-launcher": "1.2.2",
		"cross-env": "^10.1.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^30.1.3",
		"lighthouse": "13.6.0",
		"postcss": "8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "3.3.3",
		"typescript": "^5",
		"vitest": "^5.0.5"
	}
}
