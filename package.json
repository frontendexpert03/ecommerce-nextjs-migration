{
	"name": "kiiibs-next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "next typegen && tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:next": "vitest run --project next",
		"test:vue": "vitest run --project vue",
		"test:golden": "vitest run --project vue --update",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:vue": "cross-env E2E_TARGETS=vue playwright test",
		"test:parity": "cross-env E2E_TARGETS=next,vue playwright test"
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"dependencies": {
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "2.4.6",
		"@vueuse/core": "10.4.1",
		"autoprefixer": "10.4.15",
		"cross-env": "^10.1.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^30.1.3",
		"pinia": "2.1.6",
		"postcss": "8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "3.3.3",
		"typescript": "^5",
		"vitest": "^5.0.5",
		"vue": "3.3.4"
	}
}
